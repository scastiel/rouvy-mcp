{
  "name": "rouvy-mcp",
  "version": "0.2.0",
  "description": "Unofficial Rouvy MCP server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rouvy",
    "cycling",
    "indoor-cycling",
    "fit"
  ],
  "license": "MIT",
  "author": "Sebastien Castiel",
  "type": "module",
  "bin": {
    "rouvy-mcp": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scastiel/rouvy-mcp.git"
  },
  "homepage": "https://github.com/scastiel/rouvy-mcp#readme",
  "bugs": {
    "url": "https://github.com/scastiel/rouvy-mcp/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "canary": "vitest run --config vitest.live.config.ts canary.live",
    "contract:live": "vitest run --config vitest.live.config.ts contract.live"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "~2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "~2.4.0",
    "fit-file-parser": "^6.2.3",
    "turbo-stream": "^2.4.1",
    "zod": "^4.6.7"
  }
}
